APP_NAME=Cloud Assignment Portal API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://portal:portal_dev_password@localhost:5432/assignment_portal
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=10485760
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx,.zip,.png,.jpg,.jpeg
ALLOW_LATE_SUBMISSIONS=true
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage

# S3 / MinIO mode
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=assignment-portal
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
